PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=hotel_booking_db
DB_PORT=3306

# JWT Authentication
JWT_SECRET=replace_with_a_local_secret
JWT_EXPIRES_IN=7d

# AI Service (Optional - Gemini API Key)
# If left blank, the app falls back to the local recommendation logic.
GEMINI_API_KEY=
